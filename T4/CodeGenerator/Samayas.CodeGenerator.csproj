<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.2.0.0</Version>
	</PropertyGroup>

	<PropertyGroup>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<IsPackable>true</IsPackable>
		<PackageId>Samayas.CodeGenerator</PackageId>
	</PropertyGroup>
	
	<ItemGroup>
		<Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.CodeDom" Version="10.0.10" />
	</ItemGroup>

	<ItemGroup>
		<None Update="**\*.tt" />
		<Compile Update="**\*.g.cs">
			<DependentUpon>$([System.IO.Path]::GetFileNameWithoutExtension('%(Filename)')).tt</DependentUpon>
		</Compile>
	</ItemGroup>

	<Target Name="PreprocessT4Templates" BeforeTargets="BeforeBuild">
		<Exec Command="dotnet tool restore" />

		<ItemGroup>
			<T4Templates Include="**\*.tt" Exclude="bin\**;obj\**" />
		</ItemGroup>

		<Message Text="Processing @(T4Templates-&gt;Count()) T4 templates..." Importance="high" />

		<!-- Debug: Show what namespace will be generated for each template -->
		<Message Text="Template: %(T4Templates.Identity)" Importance="high" />
		<Message Text="  RecursiveDir: %(T4Templates.RecursiveDir)" Importance="high" />
		<Message Text="  Filename: %(T4Templates.Filename)" Importance="high" />
		<Message Text="  Calculated Class: Samayas.CodeGenerator.$([System.String]::Copy('%(T4Templates.RecursiveDir)%(T4Templates.Filename)').Replace('\', '.').TrimEnd('.'))" Importance="high" />

		<Exec Command="dotnet t4 &quot;%(T4Templates.Identity)&quot; -c &quot;Samayas.CodeGenerator.$([System.String]::Copy('%(T4Templates.RecursiveDir)%(T4Templates.Filename)').Replace('\', '.').TrimEnd('.'))&quot; -o &quot;%(T4Templates.RelativeDir)%(T4Templates.Filename).g.cs&quot;" WorkingDirectory="$(ProjectDir)" ContinueOnError="false" />

		<Message Text="✓ Generated %(T4Templates.Identity)" Importance="high" />
	</Target>

</Project>
