@model UploadAndScan2Full.Models.UploadViewModel
@{
    ViewData["Title"] = "Home Page";
}

<h2>Upload Files</h2>

<form asp-action="Index" method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label for="files">Select files to upload:</label>
        <input type="file" name="files" id="files" multiple class="form-control" />
        <span class="text-danger" asp-validation-for="Files"></span>
    </div>
    
    <button type="submit" class="btn btn-primary">Upload</button>
</form>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-info mt-3">
        @TempData["SuccessMessage"]
    </div>
}

<div class="alert alert-danger mt-3" asp-validation-summary="ModelOnly"></div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}