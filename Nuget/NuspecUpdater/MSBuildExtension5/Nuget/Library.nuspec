<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2011/08/nuspec.xsd">
  <metadata>
    <id>Samayas.Library</id>
    <version>2.0.0</version>
    <title>Samayas Library</title>
    <authors>Samayas Consulting</authors>
    <owners>Samayas Consulting</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Samayas Library Description.</description>
    <copyright>Samayas Consulting</copyright>
    <iconUrl>https://www.samayas.eu/images/logo/nugetpackage.png</iconUrl>
    <dependencies>
      <group targetFramework=".netcoreapp9.0">
        <dependency id="Microsoft.AspNetCore.Components" version="9.0.7" />
        <dependency id="Microsoft.Extensions.Options" version="9.0.11" />
        <dependency id="NETStandard.Library" version="2.0.3" />
        <dependency id="Newtonsoft.Json" version="13.0.3" />
        <dependency id="Newtonsoft.Json1" version="13.0.4" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="..\MainLibrary\bin\debug\net9.0\MainLibrary.dll" target="lib\net9.0\MainLibrary.dll" />
    <file src="..\SecondaryLibrary\bin\debug\net9.0\SecondaryLibrary.dll" target="lib\net9.0\SecondaryLibrary.dll" />
  </files>
</package>