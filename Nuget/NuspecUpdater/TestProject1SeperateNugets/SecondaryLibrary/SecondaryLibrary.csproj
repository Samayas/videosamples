<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>1.0.0</Version>
		<Product>Samayas Secondary Library</Product>
		<Description>Samayas Secondary Library Description.</Description>
		<Copyright>Samayas Consulting</Copyright>
		<Authors>Samayas Consulting</Authors>
	</PropertyGroup>

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<PackageId>SecondaryLibrary</PackageId>
		<PackageVersion>1.0.0</PackageVersion>
		<PackageIconUrl>https://www.samayas.eu/images/logo/nugetpackage.png</PackageIconUrl>
		<PackageTags>netcore;samayas;sample</PackageTags>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Options" Version="9.0.6" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
	</ItemGroup>

</Project>
