{
  "metadata": [
    {
      "src": [
        {
          "files": [ "FwkLibrary/*.csproj" ],
          "src": "..",
          "exclude": [ "**/obj/**", "**/bin/**", "**/**Designer.cs", "**/DocFX.csproj" ]
        }
      ],
      "dest": "obj/api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [ "api/**.yml" ],
        "src": "obj"
      },
      {
        "files": [ "api/*.md", "articles/**.md", "toc.yml", "*.md" ],
        "exclude": [ "obj/**", "_site/**" ]
      }
    ],
    "resource": [
      {
        "files": [ "images/**" ],
        "exclude": [ "obj/**", "_site/**", "**/**Designer.cs", "**/Doc.csproj" ]
      }
    ],
    "overwrite": [
      {
        "files": [ "apidoc/**.md" ],
        "exclude": [ "obj/**", "_site/**" ]
      }
    ],
    "dest": "_site",
    "template": [ "default" ],
    "globalMetadata": {
      "_appTitle": "Framework",
      "_appName": "Documentation",
      "_appFooter": "<span>&copy; 2025 Samayas Consulting.</span>",
      "_appFaviconPath": "images/favicon.ico",
      "_appLogoPath": "images/samayas.svg",
      "_disableContribution": "false",
      "_enableSearch": true
    },
    "sitemap": {
      "baseUrl": "http://site/Framework",
      "priority": 0.1,
      "changefreq": "monthly",
      "fileOptions": {
        "**/api/**.yml": {
          "priority": 0.3,
          "changefreq": "weekly"
        }
      }
    }
  }
}