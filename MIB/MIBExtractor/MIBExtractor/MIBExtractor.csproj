<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="MIBs\mikrotik.mib" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="MIBs\mikrotik.mib">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Samayas.Tools.MIBExtractor" Version="1.0.7" />
  </ItemGroup>

</Project>
